---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
// Until their directory tickets, these destinations are explicit home placeholders.
const links = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Writing', href: '/#writing' },
];
---

<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label="Triet's Engineering Field Notes — Home">
      TRIET <span aria-hidden="true">/</span> FIELD NOTES
    </a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        {links.map(({ label, href }) => (
          <li>
            <a href={href} aria-current={pathname === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
        <li><a href={site.githubUrl}>GitHub <span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: var(--rule); }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-6);
  }
  .brand {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink);
  }
  .brand span { color: var(--accent); }
  nav { max-width: 100%; }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }
  .nav-links a:hover, .nav-links a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }
  .nav-links a[aria-current='page'] { font-weight: 600; }
</style>

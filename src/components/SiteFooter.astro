---
import { site, type ContactLinks } from '../data/site';

interface Props {
  contact?: ContactLinks;
}
const { contact = site.contact } = Astro.props;
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <p class="footer-label">TRIET / FIELD NOTES</p>
    <nav aria-label="Contact">
      <ul>
        <li><a href={site.githubUrl}>GitHub <span aria-hidden="true">↗</span></a></li>
        {contact.linkedin && <li><a href={contact.linkedin}>LinkedIn</a></li>}
        {contact.email && <li><a href={`mailto:${contact.email}`}>Email</a></li>}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer { border-top: var(--rule); }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-8);
  }
  .footer-label {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
  }
  nav { min-width: 0; }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  a { display: inline-flex; align-items: center; gap: var(--space-1); min-height: 44px; }
</style>

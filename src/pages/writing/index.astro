---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortArticlesByDate } from '../../utils/content';

// In dev mode, show drafts so the author can inspect listings; in prod build, strictly exclude drafts.
const rawArticles = await getCollection('writing', ({ data }) => {
  return import.meta.env.DEV ? true : !data.draft;
});
const articles = sortArticlesByDate(rawArticles);
---

<BaseLayout
  title="Writing"
  description="Technical field notes, software engineering deep dives, and learning reflections."
>
  <div class="writing-page">
    <header class="page-header">
      <p class="eyebrow">03 / FIELD NOTES</p>
      <h1>Writing</h1>
      <p class="page-intro text-muted">
        Reflections, technical deep dives, and notes from building software and data systems.
      </p>
    </header>

    {articles.length === 0 ? (
      <div class="empty-state">
        <p class="text-muted">Articles are in progress. The first field notes will appear here soon.</p>
      </div>
    ) : (
      <ul class="article-list" aria-label="Writing index">
        {articles.map((article) => {
          const dateStr = article.data.publishedAt
            ? new Intl.DateTimeFormat('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              }).format(article.data.publishedAt)
            : null;

          return (
            <li class="article-card">
              <div class="card-meta">
                {dateStr && (
                  <time datetime={article.data.publishedAt?.toISOString()} class="card-date">
                    {dateStr}
                  </time>
                )}
                {article.data.draft && (
                  <span class="draft-badge" title="Unpublished draft">
                    DRAFT
                  </span>
                )}
              </div>

              <h2 class="card-title">
                <a href={`/writing/${article.id}/`}>{article.data.title}</a>
              </h2>

              <p class="card-description">{article.data.description}</p>

              {article.data.tags.length > 0 && (
                <ul class="card-tags" aria-label="Tags">
                  {article.data.tags.map((tag) => (
                    <li class="tag-chip">#{tag}</li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .writing-page {
    max-width: var(--prose-width);
    margin-inline: auto;
    padding-block: var(--space-8) var(--section-space);
  }

  .page-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: var(--rule);
  }

  .page-intro {
    margin-top: var(--space-4);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 46ch;
  }

  .empty-state {
    padding-block: var(--space-12);
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .article-card {
    padding-bottom: var(--space-8);
    border-bottom: var(--rule);
  }

  .article-card:last-child {
    border-bottom: none;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted);
  }

  .draft-badge {
    display: inline-block;
    padding: 1px 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
    border-radius: var(--radius-control);
  }

  .card-title {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-block: 0 var(--space-2);
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .card-description {
    color: var(--muted);
    margin-block: 0 var(--space-4);
    font-size: 1rem;
    line-height: 1.6;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .tag-chip {
    border: var(--rule);
    padding: 1px 6px;
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--muted);
  }
</style>

---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  draft?: boolean;
}

const { title, description, publishedAt, updatedAt, tags = [], draft = false } = Astro.props;

const formattedDate = publishedAt
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }).format(publishedAt)
  : null;

const formattedUpdatedDate = updatedAt
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }).format(updatedAt)
  : null;
---

<BaseLayout title={title} description={description}>
  <article class="article-container">
    <header class="article-header">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/writing/">← Writing</a>
      </nav>

      <div class="meta-row">
        {formattedDate && (
          <time datetime={publishedAt?.toISOString()} class="article-date">
            {formattedDate}
          </time>
        )}
        {formattedUpdatedDate && (
          <span class="updated-date">
            (Updated: <time datetime={updatedAt?.toISOString()}>{formattedUpdatedDate}</time>)
          </span>
        )}
        {draft && (
          <span class="draft-badge" title="This post is an unpublished draft">
            DRAFT
          </span>
        )}
      </div>

      <h1 class="article-title">{title}</h1>
      <p class="article-description">{description}</p>

      {tags.length > 0 && (
        <ul class="tag-list" aria-label="Article tags">
          {tags.map((tag) => (
            <li class="tag-item">#{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article-footer">
      <a href="/writing/" class="back-link">← Back to writing</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article-container {
    max-width: var(--prose-width);
    margin-inline: auto;
    padding-block: var(--space-8) var(--section-space);
  }

  .article-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: var(--rule);
  }

  .breadcrumb {
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .breadcrumb a {
    text-decoration: none;
    color: var(--muted);
  }

  .breadcrumb a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted);
  }

  .draft-badge {
    display: inline-block;
    padding: 1px 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
    border-radius: var(--radius-control);
  }

  .article-title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-block: var(--space-2) var(--space-4);
  }

  .article-description {
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: var(--space-6);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .tag-item {
    border: var(--rule);
    padding: 2px 8px;
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--muted);
  }

  /* Scoped prose typographic styling conforming to 03-DESIGN-SPEC */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
  }

  :global(.prose > * + *) {
    margin-top: var(--space-6);
  }

  :global(.prose h2) {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule);
  }

  :global(.prose h3) {
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.015em;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  :global(.prose p) {
    margin-block: var(--space-4);
  }

  :global(.prose ul),
  :global(.prose ol) {
    padding-left: var(--space-6);
    margin-block: var(--space-4);
  }

  :global(.prose li) {
    margin-block: var(--space-2);
  }

  :global(.prose li > ul),
  :global(.prose li > ol) {
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  :global(.prose blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-4);
    margin-left: 0;
    margin-block: var(--space-6);
    color: var(--muted);
    font-style: italic;
  }

  :global(.prose hr) {
    border: none;
    border-top: var(--rule);
    margin-block: var(--space-12);
  }

  :global(.prose code:not(pre code)) {
    font-family: var(--font-code);
    font-size: 0.9em;
    background: rgba(0, 0, 0, 0.05);
    padding: 0.15em 0.35em;
    border-radius: var(--radius-control);
  }

  :global(.prose pre) {
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-control);
    margin-block: var(--space-6);
    font-family: var(--font-code);
    font-size: 0.9375rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-6);
    font-size: 0.9375rem;
  }

  :global(.prose th),
  :global(.prose td) {
    padding: var(--space-2) var(--space-4);
    border: var(--rule);
    text-align: left;
  }

  :global(.prose th) {
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .article-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: var(--rule);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 600;
  }
</style>
